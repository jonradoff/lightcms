{
  "_comment1": "=== LightCMS Development Configuration ===",
  "_comment2": "Copy this file to config.dev.json and fill in your values",
  "_comment3": "Delete these _comment lines in your actual config file",

  "_port_help": "Port to run the dev server on (default 8082 to avoid conflicts)",
  "port": "8082",

  "_mongo_uri_help": "MongoDB Atlas connection string - get this from Atlas Dashboard → Connect → Drivers",
  "mongo_uri": "mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/lightcms?retryWrites=true&w=majority",

  "_env_help": "Environment mode - use 'development' for local development",
  "env": "development",

  "_session_secret_help": "Session secret - can use a simple string for development",
  "session_secret": "dev-session-secret-change-in-prod",

  "_base_url_help": "Public URL of your site - used for sitemap and robots.txt",
  "base_url": "http://localhost:8082",

  "_secure_cookies_help": "Set to false for development (no HTTPS), true for production",
  "secure_cookies": false
}
